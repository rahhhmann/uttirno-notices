{
  "name": "@uttirno/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/adapters/parse.d.ts",
      "import": "./dist/adapters/parse.js"
    },
    "./document-review": {
      "types": "./dist/documents/review.d.ts",
      "import": "./dist/documents/review.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@uttirno/contracts": "0.1.0",
    "@uttirno/domain": "0.1.0",
    "@uttirno/llm": "0.1.0",
    "@uttirno/env": "0.1.0",
    "playwright": "1.64.1",
    "@uttirno/source-config": "0.1.0",
    "robots-parser": "3.0.1",
    "cheerio": "1.2.0",
    "ipaddr.js": "2.5.0"
  }
}
