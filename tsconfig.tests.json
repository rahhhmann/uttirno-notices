{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "apps/**/*.test.ts",
    "packages/**/*.test.ts",
    "scripts/**/*.test.ts",
    "scripts/check-services.ts",
    "scripts/benchmark-documents.ts",
    "scripts/migrate-database.ts",
    "scripts/bootstrap-identity.ts",
    "tests/integration/**/*.ts",
    "vitest*.ts",
    "tests/e2e/**/*.ts",
    "tests/deployment/**/*.ts"
  ],
  "exclude": ["node_modules", "**/dist/**", "**/.next/**"]
}
