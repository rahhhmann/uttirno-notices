# Development only; copy/configure locally. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# Your existing native PostgreSQL can be used here; no automatic schema/seed.
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:5432/uttirno_dev
REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@127.0.0.1:56379
S3_ENDPOINT=http://127.0.0.1:54566
S3_REGION=us-east-1
S3_BUCKET=uttirno-dev-artifacts
# LocalStack emulates S3 locally; never production credentials.
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
LOCAL_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_PASSWORD
LOCAL_REDIS_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_PASSWORD
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
API_PUBLIC_ORIGIN=http://127.0.0.1:4000
ADMIN_ORIGIN=http://127.0.0.1:3001
API_CURSOR_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
API_SESSION_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
SOURCE_TRUST_KEYS_FILE=
# Optional confidential OIDC client; configure all AUTH fields together. No default provider/account.
AUTH_ISSUER=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_REDIRECT_URI=
AUTH_ALLOWED_ORIGINS=
AUTH_STATE_KEY=
AUTH_ALLOW_HTTP_LOOPBACK=false

# Admin Next.js runtime settings: export these into its process (no client secrets).
ADMIN_API_ORIGIN=http://127.0.0.1:4000
ADMIN_HOME_URL=https://uttirno.org/
ADMIN_BRAND_NAME=Uttirno
# Optional API read-only mount of the SAME private archive root used by the worker.
PRIVATE_ARCHIVE_ROOT=
