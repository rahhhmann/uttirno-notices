{
    "name":  "uttirno",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "packageManager":  "npm@11.17.0",
    "engines":  {
                    "node":  "\u003e=24.19.0 \u003c25",
                    "npm":  "\u003e=11 \u003c12"
                },
    "workspaces":  [
                       "apps/*",
                       "packages/*",
                       "research/prototype"
                   ],
    "scripts":  {
                    "db:migrate": "npm run build:packages && tsx scripts/migrate-database.ts",
                    "benchmark:documents": "tsx scripts/benchmark-documents.ts",
                    "smoke:foundation":  "node scripts/smoke-foundation.mjs",
                    "lint":  "biome lint .",
                    "format":  "prettier --write apps packages scripts tests *.json vitest*.ts",
                    "build":  "node scripts/workspaces.mjs build",
                    "build:packages":  "node scripts/workspaces.mjs build-packages",
                    "typecheck":  "node scripts/workspaces.mjs typecheck \u0026\u0026 tsc -p tsconfig.tests.json",
                    "check:boundaries":  "node scripts/check-boundaries.mjs",
                    "test:unit":  "npm run build:packages \u0026\u0026 vitest run",
                    "test:prototype":  "npm run test --workspace @uttirno/research-prototype",
                    "test":  "npm run test:unit \u0026\u0026 npm run test:prototype",
                    "check":  "npm run lint \u0026\u0026 npm run check:boundaries \u0026\u0026 npm run typecheck \u0026\u0026 npm test",
                    "dev:api":  "npm run dev --workspace @uttirno/api",
                    "dev:portal":  "npm run dev --workspace @uttirno/portal",
                    "dev:admin":  "npm run dev --workspace @uttirno/admin",
                    "local:init":  "node scripts/local-init.mjs",
                    "local:up":  "docker compose --env-file .env -f infra/local/compose.yaml up -d --wait",
                    "local:down":  "docker compose --env-file .env -f infra/local/compose.yaml down",
                    "check:services":  "npm run build:packages \u0026\u0026 tsx scripts/check-services.ts",
                    "test:integration":  "npm run build:packages \u0026\u0026 vitest run --config vitest.integration.config.ts"
                },
    "devDependencies":  {
                            "@aws-sdk/client-s3":  "3.1161.0",
                            "@babel/parser":  "8.1.0",
                            "@biomejs/biome":  "2.6.4",
                            "@types/node":  "24.19.2",
                            "@types/pg":  "8.23.1",
                            "@types/react":  "19.3.0",
                            "@types/react-dom":  "19.3.0",
                            "@uttirno/database":  "0.1.0",
                            "@uttirno/env":  "0.1.0",
                            "@uttirno/infrastructure":  "0.1.0",
                            "ioredis":  "6.0.0",
                            "prettier":  "3.9.10",
                            "tsx":  "4.23.15",
                            "typescript":  "7.0.2",
                            "vitest":  "5.1.0",
                            "@uttirno/source-config":  "0.1.0"
                        }
}
